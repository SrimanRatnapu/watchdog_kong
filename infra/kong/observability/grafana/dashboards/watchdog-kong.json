   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Rate-limited requests (429)",
   "description": "Kong's per-role rate limit; llm.py retries a 429 once.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (consumer) (rate(kong_http_requests_total{code=\"429\"}[1m])) * 60",
     "legendFormat": "{{consumer}}",
     "refId": "A",
     "instant": false,
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(kong_http_requests_total{code=\"429\"}[1m])) * 60 or vector(0)",
     "legendFormat": "all roles",
     "refId": "B",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
