   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "namePlacement": "top",
    "valueMode": "color",
    "text": {
     "titleSize": 15,
     "valueSize": 18
